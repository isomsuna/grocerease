DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Enable only when the trusted ingress proxy strips client-supplied X-Forwarded-Proto headers.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# Comma-separated HTTPS origins served by the frontend/API, such as https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Number of trusted reverse proxies that append X-Forwarded-For. Set explicitly in production.
DJANGO_NUM_PROXIES=0
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-mail-username
DJANGO_EMAIL_HOST_PASSWORD=replace-with-mail-password
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10

POSTGRES_DB=grocerease
POSTGRES_USER=grocerease
POSTGRES_PASSWORD=grocerease
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
